# Copia este archivo a .env.local (no se versiona) y llena los valores de pyp-dev.
# Modo sin Docker: no hay base local; todo apunta al proyecto remoto de desarrollo pyp-dev.

# --- Supabase CLI (scripts db:*) ---
# Referencia de pyp-dev (Dashboard → Project Settings → General → Reference ID).
SUPABASE_DEV_PROJECT_REF=
# Referencia del proyecto de producción, solo para que los scripts se nieguen a usarlo. Nunca se enlaza.
SUPABASE_PROD_PROJECT_REF=
# Contraseña de la base de pyp-dev; la usan db:reset y test:db (conexión directa a Postgres).
SUPABASE_DB_PASSWORD=

# --- Sitio (build y cliente, TRD §16) ---
SITE_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<SUPABASE_DEV_PROJECT_REF>.supabase.co
# Llave pública (anon / publishable) de pyp-dev. La service_role NUNCA va aquí.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MEDIA_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=

      {
        "key": "uniforms_faq",
        "value": [
          {
            "answer": "[PEDIDO MÍNIMO]",
            "question": "¿Cuál es el pedido mínimo?"
          },
          {
            "answer": "[TIEMPO DE ENTREGA]",
            "question": "¿Cuánto tarda la entrega?"
          },
          {
            "answer": "Sí, en tallas infantiles y de adulto. [CONDICIONES DE REPOSICIÓN]",
            "question": "¿Puedo pedir reposiciones después?"
          },
          {
            "answer": "Sí. Indícalo al enviar tu cotización.",
            "question": "¿Dan factura?"
          }

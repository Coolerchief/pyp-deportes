{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Assets-only Worker: serves the static export (apps/web/out) with no server code (TRD ADR-1).
  "name": "pyp-deportes",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    // Next writes /catalogo as catalogo.html (trailingSlash: false); unknown paths get 404.html.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
}
